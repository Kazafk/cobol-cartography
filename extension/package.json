{
  "name": "cobol-cartography",
  "displayName": "COBOL Cartography",
  "description": "Cartograph and analyse large COBOL portfolios with AI assistance",
  "version": "0.1.0",
  "publisher": "cobol-cartography",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cobol-cartography",
          "title": "COBOL Cartography",
          "icon": "resources/inventory.svg"
        }
      ]
    },
    "views": {
      "cobol-cartography": [
        {
          "id": "cobol-cartography.inventory",
          "name": "Inventory"
        }
      ]
    },
    "commands": [
      {
        "command": "cobol-cartography.indexWorkspace",
        "title": "COBOL Cartography: Index Workspace",
        "icon": "$(database)"
      },
      {
        "command": "cobol-cartography.refreshInventory",
        "title": "Refresh Inventory",
        "icon": "$(refresh)"
      },
      {
        "command": "cobol-cartography.showProgramSheet",
        "title": "View Program Sheet",
        "icon": "$(info)"
      },
      {
        "command": "cobol-cartography.explainProgram",
        "title": "Explain Program (AI)",
        "icon": "$(lightbulb)"
      },
      {
        "command": "cobol-cartography.analyzeCopybookImpact",
        "title": "Analyze Copybook Impact",
        "icon": "$(search)"
      },
      {
        "command": "cobol-cartography.showGraphView",
        "title": "COBOL Cartography: Show Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "cobol-cartography.analyzeTableImpact",
        "title": "COBOL Cartography: Analyze Table Impact",
        "icon": "$(symbol-field)"
      },
      {
        "command": "cobol-cartography.showJobPrograms",
        "title": "Show Programs Executed by Job",
        "icon": "$(list-tree)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cobol-cartography.refreshInventory",
          "when": "view == cobol-cartography.inventory",
          "group": "navigation"
        },
        {
          "command": "cobol-cartography.indexWorkspace",
          "when": "view == cobol-cartography.inventory",
          "group": "navigation"
        },
        {
          "command": "cobol-cartography.showGraphView",
          "when": "view == cobol-cartography.inventory",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "cobol-cartography.showProgramSheet",
          "when": "view == cobol-cartography.inventory && viewItem == cobol-file-program",
          "group": "inline"
        },
        {
          "command": "cobol-cartography.explainProgram",
          "when": "view == cobol-cartography.inventory && viewItem == cobol-file-program",
          "group": "inline"
        },
        {
          "command": "cobol-cartography.analyzeCopybookImpact",
          "when": "view == cobol-cartography.inventory && viewItem == cobol-file-copybook",
          "group": "inline"
        },
        {
          "command": "cobol-cartography.showJobPrograms",
          "when": "view == cobol-cartography.inventory && viewItem == cobol-file-jcl",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "COBOL Cartography",
      "properties": {
        "cobolCartography.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the COBOL Cartography backend server"
        },
        "cobolCartography.copybookPaths": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Additional paths to search for COBOL copybooks (absolute or relative to workspace root)"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
