{
  "name": "cobol-cartography",
  "displayName": "COBOL Cartography",
  "description": "Cartograph and analyse large COBOL portfolios with AI assistance",
  "version": "0.1.0",
  "publisher": "cobol-cartography",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cobol-cartography.indexWorkspace",
        "title": "COBOL Cartography: Index Workspace"
      }
    ],
    "configuration": {
      "title": "COBOL Cartography",
      "properties": {
        "cobolCartography.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "URL of the COBOL Cartography backend server"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
